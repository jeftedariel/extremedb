# Supabase — connection string del Transaction Pooler (puerto 6543)
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres

# Base pública del bucket R2 con las imágenes (sin slash final)
# ej. el dominio r2.dev del bucket o un dominio custom propio
R2_PUBLIC_BASE=https://pub-XXXXXXXXXXXX.r2.dev
